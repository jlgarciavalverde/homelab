# Copia como .env (chmod 600). Los valores reales se escriben en el servidor con read -rsp, nunca en el repo ni en un chat.
NODE_ENV=production
APP_VERSION=0.0.0
PUBLIC_URL=https://coach.example.com
ALLOWED_ORIGINS=https://coach.example.com
POSTGRES_PASSWORD=
